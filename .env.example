# API.Bible — https://rest.api.bible (sign up at https://scripture.api.bible/signup)
# Copy this file to .env and paste your key below.
BIBLE_API_KEY=your_api_bible_key_here

# Optional aliases (any one works):
# BIBLE_API=
# API_BIBLE_KEY=
# API_BIBLE=

# Base URL (default: https://rest.api.bible)
# API_BIBLE_BASE_URL=https://rest.api.bible

# Content-Security-Policy — report-only by default (see lib/security/csp.js).
# After validating in browser devtools, set CSP_ENFORCE=true on Vercel.
# CSP_ENFORCE=false
# CSP_REPORT_URI=https://your-csp-report-endpoint.example/report
